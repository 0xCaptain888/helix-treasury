{
  "name": "@helix/agent",
  "version": "0.5.0-alpha",
  "private": true,
  "type": "module",
  "description": "Helix Execution Agent — monitors, simulates, proposes treasury actions",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
