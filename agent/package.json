    "openai": "^4.65.0",
    "yaml": "^2.5.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "zod": "^3.23.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
