    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "viem": "^2.21.0",
    "@safe-global/protocol-kit": "^4.0.0",
    "@safe-global/api-kit": "^2.4.0",
