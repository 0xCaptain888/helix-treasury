# ─── Networks ───────────────────────────────────────────────
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_TESTNET_RPC=https://testnet.robinhoodchain.io/rpc

# Backup RPCs (recommended)
ARB_SEPOLIA_RPC_BACKUP=
ROBINHOOD_TESTNET_RPC_BACKUP=

# ─── Deployer ───────────────────────────────────────────────
# In production, use AWS KMS / GCP KMS / Hashicorp Vault reference here, never raw keys.
DEPLOYER_PK=

# ─── Safe (multisig) ────────────────────────────────────────
# Deploy these via https://app.safe.global before deploying Helix
SAFE_OWNER=
SAFE_GUARDIAN=

# ─── Initial agent ──────────────────────────────────────────
AGENT_ADDRESS=

# ─── Oracles (Arbitrum Sepolia) ─────────────────────────────
CHAINLINK_USDC_USD_FEED=
CHAINLINK_ARB_USD_FEED=
PYTH_USDC_USD_ID=
PYTH_ARB_USD_ID=

# ─── Verification ───────────────────────────────────────────
ARBISCAN_API_KEY=

# ─── LLM (for natural-language → DSL compilation) ───────────
# Used only off-chain by the agent's NL interface; never on-chain
ANTHROPIC_API_KEY=
# or
OPENAI_API_KEY=

# ─── Notification channels ──────────────────────────────────
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_URL=
EMAIL_RECIPIENTS=
